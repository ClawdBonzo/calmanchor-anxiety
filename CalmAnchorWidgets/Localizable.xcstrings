    "Describe a moment of calm you experienced recently.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beschreibe einen ruhigen Moment, den du kürzlich erlebt hast."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Décrivez un moment de calme que vous avez vécu récemment."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最近感じた穏やかな瞬間を書いてみましょう。"
          }
        }
      }
    },
    "Describe your ideal peaceful place.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beschreibe deinen idealen Ort der Ruhe."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Décrivez votre lieu de paix idéal."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたにとって理想の安らぎの場所を描写しましょう。"
          }
        }
      }
    },
    "Each breath brings me closer to calm.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder Atemzug bringt mich der Ruhe näher."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque respiration me rapproche du calme."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ひと呼吸ごとに、落ち着きへ近づきます。"
          }
        }
      }
    },
