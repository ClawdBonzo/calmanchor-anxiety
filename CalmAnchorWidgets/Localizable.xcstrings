    "I am safe in this moment.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich bin in diesem Moment sicher."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je suis en sécurité en cet instant."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "私は今、安全です。"
          }
        }
      }
    },
    "I am stronger than my anxiety.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich bin stärker als meine Angst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je suis plus fort que mon anxiété."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "私は不安よりも強い。"
          }
        }
      }
    },
    "I choose peace over worry.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich wähle Frieden statt Sorge."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je choisis la paix plutôt que l'inquiétude."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "私は心配ではなく、平穏を選びます。"
          }
        }
      }
    },
    "I release what I cannot control.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich lasse los, was ich nicht kontrollieren kann."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je lâche prise sur ce que je ne peux pas contrôler."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コントロールできないことは手放します。"
          }
        }
      }
    },
